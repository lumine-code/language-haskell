    // reporting `diverged` or a nonzero `behind` means it is not.
    "parserSource": "github:tree-sitter/tree-sitter-haskell#97288e585b0bd44199720280d067fa35bacd81ff",
    "wasmBuildTool": "tree-sitter-cli#v0.27.0",
    "grammar": "haskell.wasm",
    "tagsQuery": "haskell-tags.scm",
    "highlightsQuery": "haskell-highlights.scm",
    "injectionsQuery": "haskell-injections.scm",
    "localsQuery": "haskell-locals.scm"
  }
}

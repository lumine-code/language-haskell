{
  ".source.haskell": {
    "bracket-matcher": {
      "autocompleteCharacters": ["()", "[]", "{}", "\"\"", "''"],
      "autocompleteDisabledCharacters": ["'"]
    },
    "editor": {
      "commentStart": "-- ",
      "nonWordCharacters": "/\\()\":,.;<>~!@#$%^&*|+=[]{}`?-…",
      "commentDelimiters": {
        "line": "--",
        "block": ["{-", "-}"]
      }
    }
  }
}
